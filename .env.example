# Copy to .env.local and fill in. Never commit .env.local.
# Supabase dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS. Imported exclusively by src/lib/supabase/admin.ts.
# If this ever gains a NEXT_PUBLIC_ prefix, treat the key as compromised and rotate it.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to true only once custom SMTP is configured in Supabase. The built-in
# mailer allows 2 messages per hour and may not reach outside addresses, so this
# defaults to false and the Add user dialog offers a temporary password instead.
SUPABASE_EMAIL_ENABLED=false

# Phase 3 only, and only if the pgsodium path is abandoned for the
# application-layer AES fallback described in SYSTEM_DESIGN.md section 7.3.
# 32 bytes, base64: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Phase 7
SENTRY_DSN=
